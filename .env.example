# Desarrollo: DJANGO_SETTINGS_MODULE=config.settings
# Producción: DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-50-caracteres
DJANGO_ALLOWED_HOSTS=crm.ejemplo.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.ejemplo.es
DATABASE_URL=postgresql://crm_usuario:contrasena@127.0.0.1:5432/crm

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=true
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
DJANGO_LOG_LEVEL=INFO

CRM_BACKUP_ROOT=/var/backups/inmobiliaria-crm
CRM_BACKUP_MAX_ARCHIVE_BYTES=5368709120
CRM_BACKUP_MAX_UNCOMPRESSED_BYTES=10737418240
CRM_MAX_REQUEST_BYTES=12582912
CRM_MAX_FILE_MEMORY_BYTES=5242880

# Opcional
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_RELEASE=
